# Variáveis de ambiente para o ambiente de desenvolvimento local.
# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env NUNCA deve ser commitado — já está no .gitignore.

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123
RABBITMQ_VHOST=/

# SQL Server
SQL_SA_PASSWORD=NotifSystem@2024!

# Connection strings prontas para usar no appsettings.Development.json
# (informativo — não são lidas pelo docker-compose diretamente)
# RABBITMQ_CONNECTION=amqp://admin:admin123@localhost:5672/
# SQL_CONNECTION=Server=localhost,1433;Database=NotificationSystem;User Id=sa;Password=NotifSystem@2024!;TrustServerCertificate=True
