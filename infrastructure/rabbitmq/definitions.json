  "exchanges": [
    {
      "name": "pulse.topic",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "pulse.dlx",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "email.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "pulse.dlx",
        "x-message-ttl": 300000,
        "x-queue-type": "classic"
      }
    },
    {
      "name": "push.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "pulse.dlx",
        "x-message-ttl": 300000,
        "x-queue-type": "classic"
      }
    },
    {
      "name": "pulse.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic"
      }
    }
  ],
  "bindings": [
    {
      "source": "pulse.topic",
      "vhost": "/",
      "destination": "email.queue",
      "destination_type": "queue",
      "routing_key": "pulse.email.#",
      "arguments": {}
    },
    {
      "source": "pulse.topic",
      "vhost": "/",
      "destination": "push.queue",
      "destination_type": "queue",
      "routing_key": "pulse.push.#",
      "arguments": {}
    },
    {
      "source": "pulse.dlx",
      "vhost": "/",
      "destination": "pulse.dlq",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ]
