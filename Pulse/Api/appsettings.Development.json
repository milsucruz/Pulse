{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=PulseDB;User Id=sa;Password=Pulse#Dev@2026;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin123",
    "VirtualHost": "/",
    "ExchangeName": "pulse.topic",
    "DeadLetterExchange": "pulse.dlx",
    "DeadLetterQueue": "pulse.dlq"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning",
        "RabbitMQ.Client": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  }
}
